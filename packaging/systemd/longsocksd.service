[Unit]
Description=Longsocks reverse proxy
Documentation=https://github.com/markkurossi/longsocks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=longsocks
Group=longsocks
ExecStart=/usr/sbin/longsocksd
Restart=on-failure
RestartSec=5
StateDirectory=longsocks
RuntimeDirectory=longsocks
RuntimeDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/longsocks /run/longsocks

[Install]
WantedBy=multi-user.target
